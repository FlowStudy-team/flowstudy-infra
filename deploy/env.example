SWR_REGISTRY=swr.cn-east-3.myhuaweicloud.com
SWR_NAMESPACE=flowstudy

# Default fallback tag. Prefer setting per-service tags for multi-repo deploys.
IMAGE_TAG=latest
WEB_IMAGE_TAG=latest
SERVER_IMAGE_TAG=latest
JUDGE_IMAGE_TAG=latest
OPENCODE_IMAGE_TAG=latest

SPRING_PROFILES_ACTIVE=prod

MYSQL_DATABASE=flowstudy
MYSQL_USER=flowstudy
MYSQL_PASSWORD=replace-with-real-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-real-root-password

REDIS_PASSWORD=replace-with-real-redis-password

RABBITMQ_DEFAULT_USER=flowstudy
RABBITMQ_DEFAULT_PASS=replace-with-real-rabbitmq-password
RABBITMQ_VHOST=/
JUDGE_SUBMISSION_QUEUE=flowstudy.judge.submission.v3

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRE_SECONDS=7200

# Production defaults. A manual workflow dispatch can temporarily override
# these values for an isolated performance test without changing this file.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_STORE_ORDER_PER_WINDOW=5

ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=replace-with-real-elasticsearch-password
ELASTICSEARCH_INDEX=flowstudy-content
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

OBJECT_STORAGE_PROVIDER=mock
OBS_BUCKET=
OBS_ENDPOINT=https://obs.cn-east-3.myhuaweicloud.com
OBS_REGION=cn-east-3
OBS_ACCESS_KEY=
OBS_SECRET_KEY=
